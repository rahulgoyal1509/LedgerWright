# Copy this file to .env and fill in your real key.
# .env is gitignored — never commit real keys.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — defaults to gemini-2.0-flash if not set
# GEMINI_MODEL=gemini-2.0-flash


# Optional — matching/verification thresholds. Uncomment to override the
# defaults below. Can also be overridden per-request via the /reconcile and
# /reconcile/report API form fields, which take priority over these.
# MAX_TIMING_LAG_DAYS=10
# ROUNDING_ABS_TOLERANCE=1.0
# ROUNDING_PCT_TOLERANCE=0.005